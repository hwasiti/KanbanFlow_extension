{
  "manifest_version": 3,
  "name": "KanbanFlow: Add Task Above",
  "version": "1.3.0",
  "description": "Adds insert-above commands to KanbanFlow task and subtask menus.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://kanbanflow.com/board/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
