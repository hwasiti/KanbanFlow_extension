{
  "manifest_version": 3,
  "name": "KanbanFlow: Add Task Above",
  "version": "1.0.1",
  "description": "Adds an Add task above command to KanbanFlow task-card context menus.",
  "content_scripts": [
    {
      "matches": [
        "https://kanbanflow.com/board/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
